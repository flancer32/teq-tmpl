{
  "compilerOptions": {
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext"
  },
  "include": [
    "src",
    "test",
    "types.d.ts",
    "node_modules/@teqfw/cfg/src",
    "node_modules/@teqfw/cfg/types.d.ts",
    "node_modules/@teqfw/di/src",
    "node_modules/@teqfw/di/types.d.ts",
    "node_modules/@teqfw/log/src",
    "node_modules/@teqfw/log/types.d.ts"
  ]
}
