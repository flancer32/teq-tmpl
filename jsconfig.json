{
  "compilerOptions": {
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext"
  },
  "include": [
    "src",
    "test",
    "types.d.ts",
    "node_modules/@teqfw/*/src",
    "node_modules/@teqfw/*/types.d.ts"
  ]
}
